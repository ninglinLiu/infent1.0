# Copy to .env.local. Secrets remain server-side; never prefix them NEXT_PUBLIC_.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=1800
LLM_TIMEOUT_MS=90000

# json_object works with DeepSeek and many compatible providers.
# Use json_schema only if your provider supports strict JSON Schema output.
# Both modes are always validated on the server; failures fall back to rules.
LLM_STRUCTURED_OUTPUT=json_object

# Ethereum MAINNET only. Defaults to a public read-only RPC.
# Use a dedicated provider for reliable production limits; keep its key private.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional embeddings. The default is deterministic lexical retrieval.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Enable Web Analytics in Vercel project settings, then set this before building.
# No chat text, wallet addresses or custom chat events are sent to Analytics.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
